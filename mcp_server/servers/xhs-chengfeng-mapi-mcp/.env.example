# 小红书乘风 MAPI 凭证配置
# 复制本文件为 .env 并填入真实值；.env 已被建议加入 .gitignore

# 应用三要素（小红书开放平台申请应用后获得），用于自动刷新 token
XHS_APP_ID=123456789
XHS_SECRET=your_app_secret_here
XHS_REFRESH_TOKEN=your_refresh_token_here

# 默认广告主ID（可选）：调用报表工具时不传 advertiser_id 则使用该值
XHS_ADVERTISER_ID=12345

# 手动 access_token（可选）：仅当无法使用应用三要素自动刷新时填写
# XHS_ACCESS_TOKEN=your_access_token_here

# 网关覆盖（可选，一般无需修改）
# XHS_API_BASE=https://adapi.xiaohongshu.com
