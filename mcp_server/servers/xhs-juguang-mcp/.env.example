# 小红书聚光 MAPI 凭证配置模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，禁止提交）
#
# ⚠️ 安全：本文件只放占位符。任何真实密钥/ token 都不允许写进本文件，
#    因为 .example 后缀不受 .gitignore 保护，会被一并提交到公开仓库。

# ── 应用三要素（小红书开放平台「应用管理」获取）────────────────────────
# 应用 ID：同一广告主下可以有多个应用。聚光与乘风建议用不同应用，scope 相互独立。
#   聚光示例 scope: ["report_service","ad_query","ad_manage","account_manage"]
#   乘风示例 scope: ["wind_report"]
XHS_APP_ID=your_app_id_here

# 应用密钥（开放平台获取）
XHS_SECRET=your_app_secret_here

# OAuth 授权后换取的 refresh_token（30 天有效，每次刷新自动轮换写回 .env）
# 获取方式：浏览器打开
#   https://ad-market.xiaohongshu.com/auth?appId=<APP_ID>&scope=<SCOPE>&redirectUri=http://localhost/oauth/callback&state=abcd
# 点授权后从地址栏取 auth_code（localhost 页面打不开没关系），
# 再调 MCP 的 oauth_access_token(auth_code=...) 换取，服务会自动写回 .env。
XHS_REFRESH_TOKEN=your_refresh_token_here

# 默认广告主 ID（可选）：调用工具时不传 advertiser_id 则使用该值
XHS_ADVERTISER_ID=your_advertiser_id_here

# ⚠️ 写操作总开关：默认为空 = 全部写操作拦截（强烈建议保持为空）
# 确需执行建计划/改出价/删广告组/转账等操作时改为 1，并重启 MCP。
# 特别提醒：finance_transfer（资金转账）、targettemplate_apply（可能直接改线上投放）
# 即使开了也建议保持关闭。
XHS_ALLOW_WRITE=

# 网关覆盖（一般无需修改）
# XHS_API_BASE=https://adapi.xiaohongshu.com

# 请求超时秒数（一般无需修改）
# XHS_HTTP_TIMEOUT=30