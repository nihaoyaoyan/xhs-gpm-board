# ---------- 数据库 ----------
POSTGRES_USER=xhs
POSTGRES_PASSWORD=xhs_pass
POSTGRES_DB=xhs_insight
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://xhs:xhs_pass@localhost:5432/xhs_insight

# ---------- 后端 ----------
API_PORT=8000
WEB_PORT=8080
MCP_PORT=9000
# 小红书广告侧 MCP：乘风 9101 / 聚光 9102
MCP_CHENGFENG_PORT=9101
MCP_JUGUANG_PORT=9102
JWT_SECRET=please-change-this-in-production
JWT_EXPIRE_MINUTES=720
MCP_API_TOKEN=dev-service-token
SCHEDULER_ENABLED=true

# 数据源：mock（默认，无需凭证） | qianfan（真实千帆开放平台）
DATA_PROVIDER=mock
QIANFAN_BASE_URL=https://openapi.xiaohongshu.com
QIANFAN_APP_KEY=
QIANFAN_APP_SECRET=

# 情感分析：auto（有 LLM Key 用大模型，否则本地） | local | llm
ANALYZER_MODE=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 首次启动是否灌入演示数据（接入真实数据后保持 false）
SEED_ON_STARTUP=false
